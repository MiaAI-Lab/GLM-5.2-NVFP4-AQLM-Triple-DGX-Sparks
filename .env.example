# Copy to .env and edit. Never commit .env (secrets + machine-local paths).
#
# Typical fleet: SAME username on head + both workers, SSH key auth.
#   WORKER_USER=$USER   (or set explicitly below)
#   leave WORKER_PASS empty once keys work

# ─── cluster ──────────────────────────────────────────────────────────────────
HEAD_IP=10.0.0.1
WORKER1_IP=10.0.0.2
WORKER2_IP=10.0.0.3

# Same account on every Spark (recommended)
WORKER_USER=spark
# WORKER_PASS=          # optional; prefer SSH keys
SSH_IDENTITY=$HOME/.ssh/id_ed25519_shared

# Only if workers need a non-$HOME weight link path (asymmetric multi-user):
# WEIGHT_LINK_ROOT=/home/shared/models/hf

# ─── fabric (ConnectX-7 RoCE) — adjust to your NICs ───────────────────────────
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_DEBUG=WARN
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_GID_INDEX=3
NCCL_GIN_ENABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_HOST_DIR=$HOME/nccl-2.30.7
VLLM_NCCL_SO_PATH=/nccl/libnccl.so.2.30.7
NCCL_GRAPH_MIXING_SUPPORT=1

# ─── image / fork ─────────────────────────────────────────────────────────────
# Recommended arm64/sm121 image on GHCR (public; anonymous pull works):
# k12l1-vision = 20260724 + K1/K2 AQLM cold-path kernels + L1 draft capture fix
#   + glm5v vision wrapper + num_experts_per_tok override fix (serves text AND
#   vision configs; == :latest)
IMAGE=ghcr.io/miaai-lab/glm-5.2-nvfp4-triple-dgx-sparks:k12l1-vision
# Local rebuild alternative:
# IMAGE=glm52-aqlm-sm121
DOCKERFILE=Dockerfile.glm52-sm121
VLLM_FORK_URL=https://github.com/jarrelscy/vllm-glm52-sm120
VLLM_FORK_BRANCH=glm52-sm120
VLLM_FORK_DIR=$HOME/src/vllm-glm52-sm120

# K1/K2 cold-path gather knobs (bit-exact; require the :k12l1 image or the
# dev/docker/k12l1-backport bake — ignored harmlessly on older images)
GLM_MOE_AQLM_CB=l1
GLM_MOE_AQLM_STREAM=1
GLM_NVFP4_STREAM=1

# ─── weights ──────────────────────────────────────────────────────────────────
HF_REPO=jarrelscy/GLM-5.2-NVFP4-AQLM-hybrid
# Vision-era main (glm5v config: MoonViT tower + unchanged text backbone) — the
# default recipe. Text-only pin: 2d2ee496fbbe81222789bc8828a770241d2ffa2b
HF_REVISION=53e0082eedebd806b63e19779c47905937d768ca
# REQUIRED for the vision tower at TP3 (16 heads not divisible by 3)
MM_ENCODER_TP_MODE=data
MODEL_DIR=$HOME/models/hf/GLM-5.2-NVFP4-AQLM-hybrid
COMMON_MODEL=/var/tmp/glm52-aqlm

# ─── serve (max single-session context recipe) ────────────────────────────────
TP_SIZE=3
DCP_SIZE=1
PP_SIZE=1
DCP_COMM_BACKEND=ag_rs
# Spec decode: MTP (default, max ctx) XOR DSpark (external draft). Not both.
ENABLE_MTP=1
ENABLE_DSPARK=0
MTP_SPEC_TOKENS=3
# DSpark (optional) — see README "DSpark speculative decode"
# ENABLE_DSPARK=1
# ENABLE_MTP=0
# DSPARK_SPEC_TOKENS=3   # K=3 measured best; K=7 collapsed mixed (~6 tok/s)
# DSPARK_MODEL_DIR — REQUIRED, no safe default: start.sh's built-in default
# points at the RedHat bf16 preview; if workers carry the W4A16 Sparkulator
# copy instead, serve dies at draft load (KeyError: 'fc.weight_packed').
# Head and workers MUST mount the same checkpoint.
# DSPARK_MODEL_DIR=$HOME/models/hf/Sparkulator-GLM-5.2
# COMMON_DSPARK=/var/tmp/glm52-dspark
# With DSpark prefer MAX_MODEL_LEN=100000..150000 (not 380k) — draft ~4.6 GiB
PORT=8888
GPU_MEM_UTIL=0.895
MAX_MODEL_LEN=348160
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
SERVED_MODEL_NAME=glm-5.2
KV_CACHE_DTYPE=nvfp4_ds_mla
# 11 GiB pin → ~354k token pool on this stack (vision recipe; with
# index_topk_freq=8); ~33 KB/token → ~32k tokens per GiB. Text-only variant:
# 12 GiB (12884901888) → pool 386,688 + MAX_MODEL_LEN=380928. ~12 GiB is about
# the ceiling on 121 GiB nodes (~1 GiB free after boot) — do not raise without
# freeing memory first.
KV_CACHE_MEMORY_BYTES=11811160064
CUDAGRAPH_MODE=FULL
CUDAGRAPH_CAPTURE_SIZES=4,8,12,16,20,24
FUSE_GEMM_COMMS=0
FUSE_PASSES=ar,norm
VLLM_MARLIN_USE_ATOMIC_ADD=1
ASYNC_SCHEDULING=1
HF_OVERRIDES='{"num_experts_per_tok":4,"index_topk_freq":8}'
VLLM_DISABLE_FP8_W8A16=0

# ─── concurrent serving (max throughput for multi-user loads) ─────────────────
# Swap these four values into the serve block above for 4-concurrent serving.
# Measured: 28.9 tok/s aggregate at 4 concurrent (1.8× single-seq baseline).
# See README "Concurrent serving" for the full batching sweep.
# KV_CACHE_DTYPE=fp8_ds_mla
# KV_CACHE_MEMORY_BYTES=12884901888   # 12 GiB
# MAX_MODEL_LEN=65536                 # reduced from 348k to fit 4 concurrent sessions
# MAX_NUM_SEQS=4
