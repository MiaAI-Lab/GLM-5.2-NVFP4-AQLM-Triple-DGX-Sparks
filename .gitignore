# Whitelist: only track files required to run / stop this vLLM stack.
# (Ignore top-level entries; do not use !*/ or nested repos like vendor/ leak in.)

# Explicit local archives / runtime noise (never upload)
/dev/
/logs
/logs/
.env
.env.*
!.env.example
!.env.fp8.example

/*
!.gitignore
!README.md
!CHANGELOG.md
!LICENSE
!start.sh
!start_fp8.sh
!stop.sh
!.env.example
!.env.fp8.example
!scripts/

/scripts/*
!/scripts/remote.py

# Explicit: root docs stay local. Only README.md and CHANGELOG.md are public.
*.md
!README.md
!CHANGELOG.md
