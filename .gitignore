# Whitelist: only track files required to run / stop this vLLM stack.
# (Ignore top-level entries; do not use !*/ or nested repos like vendor/ leak in.)

/*
!.gitignore
!README.md
!start.sh
!stop.sh
!.env.example
!scripts/

/scripts/*
!/scripts/remote.py

# Explicit: root docs stay local (HANDOFF, PLAN, TP3, …). Only README.md is public.
*.md
!README.md
